{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inex Island",
  "version": "0.2.0",
  "identifier": "com.inex.island",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "npm run build:main",
    "beforeBuildCommand": "npm run build:main"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Inex Island",
        "url": "index.html",
        "width": 260,
        "height": 56,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "dragDropEnabled": true
      },
      {
        "label": "settings",
        "title": "Inex Island Settings",
        "url": "settings.html",
        "width": 860,
        "height": 640,
        "center": true,
        "decorations": false,
        "transparent": true,
        "visible": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost https://*.firebasedatabase.app https://*.firebaseio.com https://api.open-meteo.com https://ipwho.is https://ipapi.co http://ip-api.com https://wttr.in; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM0OTAwNkFGNTBDMDU4Q0QKUldUTldNQlFyd2FRTkFJM2JJQ1hTcGVNSHZMTzJLT0twRE1BMkUxZTlHQ0RFZU5nK0FMSktqR3QK",
      "endpoints": [
        "https://github.com/inrwxyz/inex-island/releases/latest/download/latest.json"
      ]
    }
  }
}
