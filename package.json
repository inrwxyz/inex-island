{
  "name": "inex-island",
  "private": false,
  "version": "1.2.0",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "dev:vite": "node scripts/build-styles.mjs && vite",
    "build": "tauri build",
    "build:frontend": "node scripts/build-styles.mjs && vite build",
    "build:parts": "node scripts/build-styles.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:golden": "npm run build:frontend && node scripts/golden-ui-harness.mjs --dist",
    "clean": "cargo clean --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^26.6.11",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.65.1",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "jsqr": "^1.4.0"
  }
}
